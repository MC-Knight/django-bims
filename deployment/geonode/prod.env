# GeoNode on production: https://geonode.rbis.ur.ac.rw
#
# The host nginx (deployment/nginx/host/geonode.conf) terminates TLS and
# passes everything to the GeoNode nginx container on 127.0.0.1:5443.
# HTTPS_HOST puts that container in its HTTPS mode, so Django and GeoServer
# see exactly what an upstream GeoNode HTTPS install sees (https scheme,
# https Origin, https links in capabilities documents).
# GeoNode's own GeoServer is public at https://geonode.rbis.ur.ac.rw/geoserver/
# (BIMS's GeoServer stays at https://rbis.ur.ac.rw/geoserver/).

SITEURL=https://geonode.rbis.ur.ac.rw/
ALLOWED_HOSTS=['django', 'geonode', 'geonode.rbis.ur.ac.rw']
NGINX_BASE_URL=https://geonode.rbis.ur.ac.rw

HTTP_HOST=
HTTPS_HOST=geonode.rbis.ur.ac.rw
HTTP_PORT=80
HTTPS_PORT=443

GEOSERVER_WEB_UI_LOCATION=https://geonode.rbis.ur.ac.rw/geoserver/
GEOSERVER_PUBLIC_LOCATION=https://geonode.rbis.ur.ac.rw/geoserver/

SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Upstream uses a fixed 4G heap; this box also runs BIMS and its GeoServer.
GEOSERVER_JAVA_OPTS=-Djava.awt.headless=true -Xms512m -Xmx2G -Dgwc.context.suffix=gwc -XX:+UnlockDiagnosticVMOptions -XX:+LogVMOutput -XX:LogFile=/var/log/jvm.log -XX:PerfDataSamplingInterval=500 -XX:SoftRefLRUPolicyMSPerMB=36000 -XX:-UseGCOverheadLimit -XX:ParallelGCThreads=4 -Dfile.encoding=UTF8 -Djavax.servlet.request.encoding=UTF-8 -Djavax.servlet.response.encoding=UTF-8 -Duser.timezone=GMT -Dorg.geotools.shapefile.datetime=false -DGS-SHAPEFILE-CHARSET=UTF-8 -DGEOSERVER_CSRF_DISABLED=true -DPRINT_BASE_URL=https://geonode.rbis.ur.ac.rw/geoserver/pdf -DALLOW_ENV_PARAMETRIZATION=true -Xbootclasspath/a:/usr/local/tomcat/webapps/geoserver/WEB-INF/lib/marlin-0.9.3-Unsafe.jar -Dsun.java2d.renderer=org.marlin.pisces.MarlinRenderingEngine
