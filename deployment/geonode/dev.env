# GeoNode for local development: http://localhost:63310

SITEURL=http://localhost:63310/
ALLOWED_HOSTS=['django', 'geonode', 'localhost', '127.0.0.1']
NGINX_BASE_URL=http://localhost:63310

HTTP_HOST=localhost
HTTPS_HOST=
HTTP_PORT=63310
HTTPS_PORT=443

GEOSERVER_WEB_UI_LOCATION=http://localhost:63310/geoserver/
GEOSERVER_PUBLIC_LOCATION=http://localhost:63310/geoserver/

# No TLS here, so cookies can't be Secure or logins never stick
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

GEOSERVER_JAVA_OPTS=-Djava.awt.headless=true -Xms256m -Xmx1G -Dgwc.context.suffix=gwc -XX:+UnlockDiagnosticVMOptions -XX:+LogVMOutput -XX:LogFile=/var/log/jvm.log -XX:PerfDataSamplingInterval=500 -XX:SoftRefLRUPolicyMSPerMB=36000 -XX:-UseGCOverheadLimit -XX:ParallelGCThreads=2 -Dfile.encoding=UTF8 -Djavax.servlet.request.encoding=UTF-8 -Djavax.servlet.response.encoding=UTF-8 -Duser.timezone=GMT -Dorg.geotools.shapefile.datetime=false -DGS-SHAPEFILE-CHARSET=UTF-8 -DGEOSERVER_CSRF_DISABLED=true -DPRINT_BASE_URL=http://localhost:63310/geoserver/pdf -DALLOW_ENV_PARAMETRIZATION=true -Xbootclasspath/a:/usr/local/tomcat/webapps/geoserver/WEB-INF/lib/marlin-0.9.3-Unsafe.jar -Dsun.java2d.renderer=org.marlin.pisces.MarlinRenderingEngine
