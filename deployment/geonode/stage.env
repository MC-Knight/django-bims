# GeoNode on the stage server: http://41.222.246.27:5300
#
# Plain HTTP straight to the GeoNode nginx container, the same way stage
# exposes BIMS's GeoServer on :5100.

SITEURL=http://41.222.246.27:5300/
ALLOWED_HOSTS=['django', 'geonode', '41.222.246.27']
NGINX_BASE_URL=http://41.222.246.27:5300

HTTP_HOST=41.222.246.27
HTTPS_HOST=
HTTP_PORT=5300
HTTPS_PORT=443

GEOSERVER_WEB_UI_LOCATION=http://41.222.246.27:5300/geoserver/
GEOSERVER_PUBLIC_LOCATION=http://41.222.246.27:5300/geoserver/

# No TLS here, so cookies can't be Secure or logins never stick
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

GEOSERVER_JAVA_OPTS=-Djava.awt.headless=true -Xms512m -Xmx2G -Dgwc.context.suffix=gwc -XX:+UnlockDiagnosticVMOptions -XX:+LogVMOutput -XX:LogFile=/var/log/jvm.log -XX:PerfDataSamplingInterval=500 -XX:SoftRefLRUPolicyMSPerMB=36000 -XX:-UseGCOverheadLimit -XX:ParallelGCThreads=4 -Dfile.encoding=UTF8 -Djavax.servlet.request.encoding=UTF-8 -Djavax.servlet.response.encoding=UTF-8 -Duser.timezone=GMT -Dorg.geotools.shapefile.datetime=false -DGS-SHAPEFILE-CHARSET=UTF-8 -DGEOSERVER_CSRF_DISABLED=true -DPRINT_BASE_URL=http://41.222.246.27:5300/geoserver/pdf -DALLOW_ENV_PARAMETRIZATION=true -Xbootclasspath/a:/usr/local/tomcat/webapps/geoserver/WEB-INF/lib/marlin-0.9.3-Unsafe.jar -Dsun.java2d.renderer=org.marlin.pisces.MarlinRenderingEngine
