# GeoNode 5.1.1 settings shared by every environment.
#
# Loaded by the geonode_* services in docker-compose.yml / .dev.yml /
# .stage.yml, in this order (later files win):
#   common.env  ->  prod.env | stage.env | dev.env  ->  secrets.env
# secrets.env holds the passwords; it is created by make-secrets.sh and is
# not in git.
#
# Based on GeoNode's .env.sample for 5.1.1. Format rules, so the file reads
# the same under old docker-compose v1 and Compose v2:
#   - no quotes around values (v1 would keep them as part of the value)
#   - no comments at the end of a line
#   - no "$" in values

DOCKER_ENV=production
C_FORCE_ROOT=1
FORCE_REINIT=false
INVOKE_LOG_STDOUT=true
DEBUG=False

DJANGO_SETTINGS_MODULE=geonode.settings
GEONODE_INSTANCE_NAME=geonode

# Databases. Host names below are aliases on the private "geonode" docker
# network, so they never clash with BIMS's own db / geoserver containers.
# User names must equal the database names (wait-for-databases relies on it).
POSTGRES_USER=postgres
GEONODE_DATABASE=geonode
GEONODE_DATABASE_USER=geonode
GEONODE_GEODATABASE=geonode_data
GEONODE_GEODATABASE_USER=geonode_data
GEONODE_DATABASE_SCHEMA=public
GEONODE_GEODATABASE_SCHEMA=public
DATABASE_HOST=db
DATABASE_PORT=5432
GEONODE_DB_CONN_MAX_AGE=0
GEONODE_DB_CONN_TOUT=5
DEFAULT_BACKEND_DATASTORE=datastore

BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_BEAT_SCHEDULER=celery.beat:PersistentScheduler
ASYNC_SIGNALS=True

# Data uploader
TIME_ENABLED=True
MOSAIC_ENABLED=False

# Internal wiring: GeoNode nginx -> django:8000 and geoserver:8080,
# GeoServer -> django:8000 (OAuth2 / roles), django -> geoserver:8080 (REST).
GEONODE_LB_HOST_IP=django
GEONODE_LB_PORT=8000
GEOSERVER_LB_HOST_IP=geoserver
GEOSERVER_LB_PORT=8080
GEOSERVER_LOCATION=http://geoserver:8080/geoserver/
RESOLVER=127.0.0.11
# No letsencrypt container: prod TLS is done by the host nginx + certbot
LETSENCRYPT_MODE=disabled

GEOSERVER_ADMIN_USER=admin
OGC_REQUEST_TIMEOUT=30
OGC_REQUEST_MAX_RETRIES=1
OGC_REQUEST_BACKOFF_FACTOR=0.3
OGC_REQUEST_POOL_MAXSIZE=10
OGC_REQUEST_POOL_CONNECTIONS=10
ENABLE_JSONP=true
outFormat=text/javascript

# GeoNode admin account, created on first start only
# (password: ADMIN_PASSWORD in secrets.env)
ADMIN_USERNAME=admin
ADMIN_EMAIL=tetobobo43@gmail.com

EMAIL_ENABLE=False

# Sessions / access
LOCKDOWN_GEONODE=False
X_FRAME_OPTIONS=SAMEORIGIN
SESSION_ENGINE=django.contrib.sessions.backends.cached_db
SESSION_EXPIRED_CONTROL_ENABLED=True
DEFAULT_ANONYMOUS_PERMISSIONS=download
DEFAULT_REGISTERED_MEMBERS_PERMISSIONS=download

CORS_ALLOW_ALL_ORIGINS=True
GEOSERVER_CORS_ENABLED=True
GEOSERVER_CORS_ALLOWED_ORIGINS=*
GEOSERVER_CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,HEAD,OPTIONS
GEOSERVER_CORS_ALLOWED_HEADERS=*

# Registration: open sign-up, but an admin approves new accounts
# (same policy as BIMS).
ACCOUNT_OPEN_SIGNUP=True
ACCOUNT_SIGNUP_FIELDS=['email*', 'username*', 'password1*', 'password2*']
ACCOUNT_APPROVAL_REQUIRED=True
ACCOUNT_CONFIRM_EMAIL_ON_GET=False
ACCOUNT_EMAIL_VERIFICATION=none
ACCOUNT_LOGIN_METHODS={'email', 'username'}
AUTO_ASSIGN_REGISTERED_MEMBERS_TO_REGISTERED_MEMBERS_GROUP_NAME=True
AUTO_ASSIGN_REGISTERED_MEMBERS_TO_CONTRIBUTORS=True

OAUTH2_API_KEY=
API_LOCKDOWN=False

STATIC_ROOT=/mnt/volumes/statics/static/
MEDIA_ROOT=/mnt/volumes/statics/uploaded/
ASSETS_ROOT=/mnt/volumes/statics/assets/
CACHE_BUSTING_STATIC_ENABLED=False

# GeoNode 5.1.1 always keeps login sessions (SESSION_ENGINE cached_db) and
# its background-task locks in memcached, whatever MEMCACHED_ENABLED says.
# Without this address it looks on 127.0.0.1 and every page is a 500.
# MEMCACHED_ENABLED only moves Django's general cache there as well.
MEMCACHED_ENABLED=False
MEMCACHED_LOCATION=memcached:11211

MAX_DOCUMENT_SIZE=200
CLIENT_RESULTS_LIMIT=5
API_LIMIT_PER_PAGE=1000

GEONODE_CLIENT_LAYER_PREVIEW_LIBRARY=mapstore
MAPBOX_ACCESS_TOKEN=
GOOGLE_API_KEY=

MODIFY_TOPICCATEGORY=True
AVATAR_GRAVATAR_SSL=True
EXIF_ENABLED=True
CREATE_LAYER=True
FAVORITE_ENABLED=True

RESOURCE_PUBLISHING=False
ADMIN_MODERATE_UPLOADS=False

# Celery, sized to share the host with BIMS (upstream defaults assume a
# dedicated machine: 10 + 15 worker processes). The right-hand autoscale
# value must equal the concurrency.
CELERY__AUTOSCALE_VALUES=4,2
CELERY__WORKER_CONCURRENCY=2
CELERY__HARVESTER_AUTOSCALE_VALUES=2,1
CELERY__HARVESTER_CONCURRENCY=1

HARVESTING_MONITOR_ENABLED=True
HARVESTING_MONITOR_DELAY=60

POSTGRESQL_MAX_CONNECTIONS=200
DEFAULT_MAX_PARALLEL_UPLOADS_PER_USER=5
# Upload limit in bytes (2 GiB, same as client_max_body_size in the host
# nginx). Upstream default is 100 MB, too small for the elevation rasters.
# Read when GeoNode first sets up its database; later changes go through
# GeoNode admin -> Upload size limits.
DEFAULT_MAX_UPLOAD_SIZE=2147483648
XLSX_UPLOAD_ENABLED=False
